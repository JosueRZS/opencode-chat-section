{
  "name": "opencode-vscode-chat",
  "displayName": "OpenCode Chat (Side Bar)",
  "description": "Terminal efímera con el TUI oficial de OpenCode, junto al chat en la Secondary Side Bar.",
  "version": "0.0.1",
  "publisher": "JosueRZS",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "terminal",
    "chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencodeChat.status"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "opencodeChat.status",
          "name": "OpenCode",
          "icon": "$(comment-discussion)",
          "type": "webview",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeChat.launch",
        "title": "OpenCode: Launch OpenCode Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodeChat.focus",
        "title": "OpenCode: Focus Terminal"
      },
      {
        "command": "opencodeChat.newSession",
        "title": "OpenCode: New Session"
      },
      {
        "command": "opencodeChat.sendSelection",
        "title": "OpenCode: Send Selection to Agent"
      },
      {
        "command": "opencodeChat.showOutput",
        "title": "OpenCode: Show Output"
      },
      {
        "command": "opencodeChat.toggle",
        "title": "OpenCode: Toggle Chat + OpenCode"
      }
    ],
    "keybindings": [
      {
        "command": "opencodeChat.launch",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "linux": "ctrl+alt+o"
      },
      {
        "command": "opencodeChat.focus",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o",
        "linux": "ctrl+alt+shift+o"
      },
      {
        "command": "opencodeChat.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "linux": "ctrl+alt+n"
      },
      {
        "command": "opencodeChat.sendSelection",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "linux": "ctrl+alt+enter"
      },
      {
        "command": "opencodeChat.toggle",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "linux": "ctrl+alt+k"
      }
    ],
    "configuration": {
      "title": "OpenCode Chat",
      "properties": {
        "opencodeChat.cliPath": {
          "type": "string",
          "default": "opencode",
          "scope": "machine",
          "description": "Ruta a la binaria de OpenCode. Vacío = buscar en PATH."
        },
        "opencodeChat.terminalCwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Directorio de trabajo de la terminal. Soporta ${workspaceFolder} y ~."
        },
        "opencodeChat.focusOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Enfocar la terminal al lanzarla."
        },
        "opencodeChat.disposeOnExit": {
          "type": "boolean",
          "default": true,
          "description": "Eliminar la pestaña de terminal cuando OpenCode termina."
        },
        "opencodeChat.chainExit": {
          "type": "boolean",
          "default": true,
          "description": "Encadenar `exit` al lanzar, para que la pestaña se cierre al salir de OpenCode (§7.3)."
        },
        "opencodeChat.autoLaunch": {
          "type": "boolean",
          "default": true,
          "description": "La sección OpenCode es la terminal: opencode se arranca sola al abrir la sección y se vuelve a lanzar cuando termina. Desactivarlo deja la sección inactiva hasta usar el comando OpenCode: Launch."
        },
        "opencodeChat.tuiTabs": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "auto",
            "on"
          ],
          "description": "Pestañas de sesión de la TUI de OpenCode (la barra con el título de la sesión y '+ New session'). Se aplica SOLO a la terminal de esta sección, vía OPENCODE_CLI_CONFIG_CONTENT, y no toca tu ~/.config/opencode/cli.json global. 'off' las oculta, 'auto' las muestra si cabe sitio, 'on' las fuerza."
        },
        "opencodeChat.useConptyDll": {
          "type": "boolean",
          "default": true,
          "description": "Usar el conpty.dll que trae node-pty en vez del del sistema. Es el camino que usa la propia terminal de VS Code en Windows, y evita los cuelgues de ConPTY del sistema (P-027)."
        },
        "opencodeChat.ptySpawnTimeout": {
          "type": "number",
          "default": 10000,
          "description": "Milisegundos que la extensión espera a que node-pty confirme el arranque antes de dar por bloqueado el proceso PTY (P-027)."
        },
        "opencodeChat.autoPromptInstall": {
          "type": "boolean",
          "default": true,
          "description": "Si no se detecta `opencode` en el PATH, ofrecer instalarlo con un diálogo. Aunque respondas \"No\" (o la instalación falle) la sección se abre igualmente: es una ayuda, no una puerta."
        },
        "opencodeChat.installMethod": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "npm",
            "script"
          ],
          "description": "Cómo instalar OpenCode. `npm` → `npm install -g @opencode/cli` (el paquete vigente de la v2; `opencode-ai` está congelado en la v1). `script` → `curl -fsSL https://opencode.ai/install | bash`, solo POSIX — en Windows se recurre a npm. `auto` → npm."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "opencodeChat.sendSelection",
          "group": "opencode@1"
        }
      ],
      "editor/title": [
        {
          "command": "opencodeChat.launch",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run check-types && npm run build:ext && npm run build:ptyhost && npm run build:web",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --sourcemap",
    "build:ptyhost": "esbuild src/terminal/ptyHost.ts --bundle --outfile=dist/pty-host.cjs --external:vscode --external:node-pty --format=cjs --platform=node",
    "build:web": "esbuild src/webview/client.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --minify --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --sourcemap --watch",
    "check-types": "tsc --noEmit && tsc -p tsconfig.webview.json",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
