{
  "name": "opencode-chat-section",
  "displayName": "OpenCode Chat Section",
  "description": "Runs the official OpenCode CLI in a terminal section stacked right below Copilot Chat.",
  "version": "0.0.1",
  "publisher": "JosueRZS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JosueRZS/opencode-chat-section.git"
  },
  "bugs": {
    "url": "https://github.com/JosueRZS/opencode-chat-section/issues"
  },
  "homepage": "https://github.com/JosueRZS/opencode-chat-section#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Lanza el binario `opencode` en una PTY dentro de la carpeta del workspace; no debe ejecutarse en un workspace de confianza restringida."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Necesita un sistema de archivos local y una terminal PTY real (ConPTY/pty), que no existen en workspaces virtuales del navegador."
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "terminal",
    "chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "opencode-logo": {
        "description": "OpenCode logo",
        "default": {
          "fontPath": "./resources/opencode-icons.woff",
          "fontCharacter": "\uE001"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "opencodeChat.status",
          "name": "OpenCode",
          "icon": "$(comment-discussion)",
          "type": "webview",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeChat.launch",
        "title": "%commands.launch.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodeChat.focus",
        "title": "%commands.focus.title%"
      },
      {
        "command": "opencodeChat.newSession",
        "title": "%commands.newSession.title%"
      },
      {
        "command": "opencodeChat.sendSelection",
        "title": "%commands.sendSelection.title%"
      },
      {
        "command": "opencodeChat.showOutput",
        "title": "%commands.showOutput.title%"
      },
      {
        "command": "opencodeChat.toggle",
        "title": "%commands.toggle.title%"
      },
      {
        "command": "opencodeChat.restorePosition",
        "title": "%commands.restorePosition.title%"
      },
      {
        "command": "opencodeChat.usage.refresh",
        "title": "%commands.usageRefresh.title%",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "opencodeChat.launch",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "linux": "ctrl+alt+o"
      },
      {
        "command": "opencodeChat.focus",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o",
        "linux": "ctrl+alt+shift+o"
      },
      {
        "command": "opencodeChat.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "linux": "ctrl+alt+n"
      },
      {
        "command": "opencodeChat.sendSelection",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "linux": "ctrl+alt+enter"
      },
      {
        "command": "opencodeChat.toggle",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "linux": "ctrl+alt+k"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "opencodeChat.cliPath": {
          "type": "string",
          "default": "opencode",
          "scope": "machine",
          "description": "%config.cliPath.description%"
        },
        "opencodeChat.terminalCwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "%config.terminalCwd.description%"
        },
        "opencodeChat.chainExit": {
          "type": "boolean",
          "default": true,
          "description": "%config.chainExit.description%"
        },
        "opencodeChat.autoLaunch": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoLaunch.description%"
        },
        "opencodeChat.tuiTabs": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "auto",
            "on"
          ],
          "description": "%config.tuiTabs.description%"
        },
        "opencodeChat.useConptyDll": {
          "type": "boolean",
          "default": true,
          "description": "%config.useConptyDll.description%"
        },
        "opencodeChat.ptySpawnTimeout": {
          "type": "number",
          "default": 10000,
          "description": "%config.ptySpawnTimeout.description%"
        },
        "opencodeChat.autoPromptInstall": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoPromptInstall.description%"
        },
        "opencodeChat.installMethod": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "npm",
            "bun",
            "pnpm",
            "yarn",
            "script"
          ],
          "description": "%config.installMethod.description%"
        },
        "opencodeChat.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageEnabled.description%"
        },
        "opencodeChat.usage.intervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "%config.usageInterval.description%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "opencodeChat.sendSelection",
          "group": "opencode@1"
        }
      ],
      "editor/title": [
        {
          "command": "opencodeChat.launch",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run check-types && npm run build:ext && npm run build:ptyhost && npm run build:web",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --sourcemap",
    "build:ptyhost": "esbuild src/terminal/ptyHost.ts --bundle --outfile=dist/pty-host.cjs --external:vscode --external:node-pty --format=cjs --platform=node",
    "build:web": "esbuild src/webview/client.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --minify --sourcemap",
    "build:icon": "node scripts/build-icon-font.mjs",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node --sourcemap --watch",
    "check-types": "tsc --noEmit && tsc -p tsconfig.webview.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"out/tests/**/*.test.js\"",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "l10n": "./l10n"
}
